def sandwich(*ingredients):
    print ("Making a sandwitch with: ")
    for ingredient in ingredients:
        print(f"-{ingredient}")

sandwich("Ham", "Cheese", "Letuce", "Olives")
sandwich("Peanut Butter", "Jelly")
sandwich("Letuce", "Tomato", "Bacon")